<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap5 rescap">
  <!-- Local test identity, deliberately unrelated to any reserved Store product. -->
  <Identity Name="KeyMelier.LocalTest" Publisher="CN=KeyMelier Local Test"
            Version="@@VERSION@@" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>KeyMelier (MSIX Test)</DisplayName>
    <PublisherDisplayName>KeyMelier local testing</PublisherDisplayName>
    <Description>Local MSIX compatibility test for KeyMelier</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources><Resource Language="en-us" /></Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application Id="KeyMelier" Executable="KeyMelier.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="KeyMelier (MSIX Test)"
                          Description="Local MSIX compatibility test for KeyMelier"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="KeyMelier.exe"
                        EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="keymelier-msix-test.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Required by the existing requireAdministrator executable for raw FIDO HID access.
         Sideloading can test this; Store use needs Microsoft's separate approval. -->
    <rescap:Capability Name="allowElevation" />
  </Capabilities>
</Package>
