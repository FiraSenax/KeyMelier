<?xml version="1.0" encoding="utf-8"?>
<!--
  Artifact configuration for SignPath (paste into the project's artifact
  configuration). The GitHub artifact is the PyInstaller output folder
  dist/KeyMelier; only KeyMelier's own executable is signed – bundled
  third-party libraries keep their original state.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="KeyMelier.exe" product-name="KeyMelier" product-version="*" max-matches="1">
      <authenticode-sign hash-algorithm="sha256" />
    </pe-file>
  </zip-file>
</artifact-configuration>
