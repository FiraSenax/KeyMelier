<?xml version="1.0" encoding="utf-8"?>
<!--
  Artifact configuration for SignPath (paste into the project's artifact
  configuration). The workflow submits two artifacts per release:
  1. the PyInstaller output folder (KeyMelier.exe at the root),
  2. the installer KeyMelier-Windows-Setup.exe (built from the signed folder).
  Only KeyMelier's own executables are signed – bundled third-party
  libraries keep their original state.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe" product-name="KeyMelier" product-version="*" max-matches="1">
      <authenticode-sign hash-algorithm="sha256" />
    </pe-file>
  </zip-file>
</artifact-configuration>
